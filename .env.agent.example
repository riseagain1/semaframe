# Optional non-secret Agent Gateway overrides. The gateway always binds to
# loopback. For a remote agent, put an authenticated HTTPS reverse proxy or
# private tunnel in front of it and advertise that exact origin here.
TTV_AGENT_GATEWAY_HOST=127.0.0.1
TTV_AGENT_GATEWAY_PORT=8788
TTV_AGENT_GATEWAY_PUBLIC_URL=http://127.0.0.1:8788
TTV_AGENT_VITE_PORT=4173
TTV_AGENT_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
TTV_AGENT_BODY_LIMIT_BYTES=524288
TTV_AGENT_COMMAND_TIMEOUT_MS=45000
TTV_AGENT_POLL_TIMEOUT_MS=25000
TTV_AGENT_BROWSER_TTL_MS=65000
TTV_AGENT_OFFER_TTL_MS=600000
TTV_AGENT_APPROVAL_TTL_MS=120000
