# Copy needed values into the repository-root `.env` or export them in the
# shell; this example file is not loaded directly. Shell values take precedence.
# Optional non-secret Agent Gateway overrides. The gateway always binds to
# loopback. For a remote agent, put an authenticated HTTPS reverse proxy or
# private tunnel in front of it and advertise that exact origin here.
SEMAFRAME_AGENT_GATEWAY_HOST=127.0.0.1
SEMAFRAME_AGENT_GATEWAY_PORT=8788
SEMAFRAME_AGENT_GATEWAY_PUBLIC_URL=http://127.0.0.1:8788
SEMAFRAME_AGENT_VITE_PORT=4173
SEMAFRAME_AGENT_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# Exact renderer origins accepted by the XR relay. Add the reachable HTTPS
# headset origin here; never use a wildcard.
SEMAFRAME_XR_ALLOWED_ORIGINS=http://127.0.0.1:4174,http://localhost:4174
SEMAFRAME_XR_VITE_PORT=4174
# Optional operator assertion for Windows x64 PCVR Ultra. Valid values are
# link_cable and air_link; the gateway does not detect the physical link mode.
# SEMAFRAME_XR_ULTRA_TRANSPORT=link_cable
SEMAFRAME_AGENT_BODY_LIMIT_BYTES=524288
SEMAFRAME_AGENT_COMMAND_TIMEOUT_MS=45000
SEMAFRAME_AGENT_POLL_TIMEOUT_MS=25000
SEMAFRAME_AGENT_BROWSER_TTL_MS=65000
SEMAFRAME_AGENT_OFFER_TTL_MS=600000
SEMAFRAME_AGENT_APPROVAL_TTL_MS=120000
# Voice Relay is optional and off until desktop setup + explicit arming. For a
# packaged helper, pin the exact binary digest; source development uses
# SEMAFRAME_VOICE_RELAY_ALLOW_UNSIGNED_HELPER=1 only via `npm run dev`.
# SEMAFRAME_VOICE_RELAY_HELPER_PATH=/absolute/path/to/SemaFrameVoiceRelayHelper
# SEMAFRAME_VOICE_RELAY_HELPER_SHA256=
# SEMAFRAME_VOICE_RELAY_REQUEST_TIMEOUT_MS=15000
