{
  "name": "semaframe",
  "private": true,
  "version": "0.2.0",
  "description": "A semantic spatial workspace for AI agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riseagain1/semaframe.git"
  },
  "homepage": "https://github.com/riseagain1/semaframe#readme",
  "bugs": {
    "url": "https://github.com/riseagain1/semaframe/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node scripts/dev-agent.mjs",
    "dev:vite": "vite --host 0.0.0.0",
    "dev:local": "vite --host 127.0.0.1",
    "dev:agent": "node scripts/dev-agent.mjs",
    "agent:gateway": "tsx server/agent/start.ts",
    "agent:gateway:watch": "tsx watch server/agent/start.ts",
    "agent:mcp": "tsx scripts/agent-mcp.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:workspace": "node scripts/workspace-smoke.mjs",
    "smoke:agent": "node scripts/agent-smoke.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@monogrid/gainmap-js": "^3.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "saxes": "^6.0.0",
    "three": "^0.179.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
