# Copy this file to the repository-root `.env` when needed. Node 22 loads it for
# the gateway/dev launcher; an existing shell variable always takes precedence.
# Optional same-origin Agent Gateway endpoint override for the browser.
# The normal `npm run dev` stack injects /api/agent automatically.
VITE_AGENT_CONTROL_ENDPOINT=

# Absolute standalone viewer URL embedded in host-generated pairing links.
# For a physical headset this must be an HTTPS URL the headset can reach.
VITE_XR_PUBLIC_URL=http://127.0.0.1:4174/xr.html

# Optional direct XR relay origin. Blank keeps the renderer on the safer
# same-origin /api/xr proxy configured by vite.xr.config.ts.
VITE_XR_GATEWAY_ORIGIN=

# Standalone XR development server. WebXR on a non-loopback headset origin
# requires HTTPS; provide both certificate paths or neither.
SEMAFRAME_XR_VITE_HOST=0.0.0.0
SEMAFRAME_XR_VITE_PORT=4174
SEMAFRAME_XR_HTTPS_CERT=
SEMAFRAME_XR_HTTPS_KEY=

# Optional text-only Agent Voice Relay. `npm run dev` builds the local helper
# and enables the unsigned development binary for this process only. Packaged
# launchers should instead pin the shipped helper's lowercase SHA-256 digest.
# SEMAFRAME_VOICE_RELAY_HELPER_PATH=/absolute/path/to/SemaFrameVoiceRelayHelper
# SEMAFRAME_VOICE_RELAY_HELPER_SHA256=
# SEMAFRAME_VOICE_RELAY_REQUEST_TIMEOUT_MS=15000
# SEMAFRAME_VOICE_RELAY_SKIP_BUILD=1

# Optional Windows x64 PCVR Ultra evidence provider. This is the operator's
# assertion of the physical Meta Horizon Link transport, not native detection.
# It never force-enables Ultra; missing/unsupported telemetry stays Balanced XR.
# SEMAFRAME_XR_ULTRA_TRANSPORT=link_cable

# The normal development command starts the loopback Agent Gateway and Vite.
# Agent access remains disabled until a person enables it in the app.
#   npm run dev
